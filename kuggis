#!/usr/bin/env bash
# kuggis — Coding agent sessions on exe.dev VMs. One VM per project; one
# session per name, which is a tmux session plus a git worktree on the VM.
#
#   kuggis                           cells and sessions; pick one to attach,
#                                    dispatch a brief, or inspect a definition
#   kuggis onboard --policy FILE     preview a complete development-cell setup
#   kuggis reconcile <cell>          preview repairs; --apply HASH approves that plan
#   kuggis audit <cell>              verify development readiness and record drift
#   kuggis adopt PATH --cell CELL    preview importing a committed job; --apply HASH transfers
#   kuggis cells                     list cells and their projects
#   kuggis cell <cell>               inspect a cell's read-only definition
#   kuggis ls [cell]                 sessions grouped by cell
#   kuggis dispatch [--status]       decide the Thinker's waiting requests one
#                                    by one; --status only refreshes its inbox
#   kuggis watch [--once]            carry the Thinker's requests and keep its
#                                    inbox fresh (kuggis think runs this for you)
#   kuggis url <link>                vouch for a URL so the Thinker may fetch it
#   kuggis <cell> [name] [--agent claude|codex|pi] [--project NAME]
#                                    attach to a session, starting it if needed;
#                                    --agent chooses the runtime (default: Claude; existing sessions remember)
#   kuggis done <cell> <name> [--project NAME] [--force]
#                                    end a session and remove its worktree
#   kuggis put [cell [session [file]]] [--project NAME]
#                                    upload a file (default: the clipboard image,
#                                    else your latest screenshot) to ~/inbox on
#                                    the VM; types the path into the session if
#                                    one is named, else copies it. Arguments go
#                                    in this order; a file needs a session
#   kuggis new <project> <owner/repo> [--vm NAME] [--profile NAME]
#           [--cpu N] [--memory M] [--disk D]
#                                    create the VM, grant it the repo, set it up
#   kuggis sync [cell] [--project NAME]
#                                    push scripts, token, settings and secrets
#                                    (~/.config/kuggis/secrets/<project>.env) again
#   kuggis sh <cell> [--project NAME] [cmd...]
#                                    plain ssh to a project's VM
#   kuggis token                     mint a Claude token into the keychain
#   kuggis think [--setup|--check|--agent claude|codex|pi]
#                                    the Thinker: an agent in a contained room on
#                                    this laptop, with kuggis watch (think/README.md)
#
# Existing project names still work. A cell with multiple projects requires
# --project NAME. Cell names route commands; they do not enforce isolation.
set -euo pipefail

CONF=${KUGGIS_CONFIG:-$HOME/.config/kuggis}
MAP=$CONF/vms # one line per project: <project> <vm> <owner/repo> <profile|->
SELF=$0
[ -L "$SELF" ] && SELF=$(readlink "$SELF")
HERE=$(cd "$(dirname "$SELF")" && pwd)
KEYCHAIN_SERVICE=box-claude-token
# Keepalives make a connection frozen by sleep give up ~45s after wake.
SSH_OPTS=(-o BatchMode=yes -o ConnectTimeout=10 -o ServerAliveInterval=15 -o ServerAliveCountMax=3)

die() { echo "kuggis: $*" >&2; exit 1; }
row() { [ -f "$MAP" ] && awk -v p="$1" '$1 == p' "$MAP" || true; }
projects() { [ -f "$MAP" ] && awk 'NF && $1 !~ /^#/ { print $1 }' "$MAP" || true; }
cell_tool() { python3 -I "$HERE/cells/display.py" "$1" "$CONF" "${@:2}"; }
resolve_project() { cell_tool resolve "$1" "${2:-}"; }
host_of() {
  local r; r=$(row "$1")
  [ -n "$r" ] || die "unknown project '$1' (projects live in $MAP)"
  echo "$(awk '{ print $2 }' <<<"$r").exe.xyz"
}
check_name() {
  [[ $1 =~ ^[A-Za-z0-9][A-Za-z0-9_-]*$ ]] || die "bad session name '$1' (letters, digits, - and _)"
}
# Tokens copied out of a terminal often pick up a space where the line wrapped.
token() {
  local t
  t=$(security find-generic-password -s "$KEYCHAIN_SERVICE" -w 2>/dev/null | tr -d '[:space:]')
  [ -n "$t" ] || die "no Claude token in the keychain: run kuggis token"
  printf '%s\n' "$t"
}
remote() { local host=$1; shift; ssh "${SSH_OPTS[@]}" "$host" "$@"; }

cmd_ls() {
  [ $# -le 1 ] || die "usage: kuggis ls [cell]"
  if [ -t 1 ]; then snapshot | cell_tool list "$@" --color
  else snapshot | cell_tool list "$@"; fi
}

cmd_attach() {
  local p='' name='' agent='' a host selected=''
  while [ $# -gt 0 ]; do
    a=$1
    case $a in
      --project) [ $# -ge 2 ] || die "--project needs a name"; selected=$2; shift ;;
      --codex) agent=codex ;;
      --claude) agent=claude ;;
      --pi) agent=pi ;;
      --agent) [ $# -ge 2 ] || die "--agent needs claude, codex or pi"; agent=$2; shift ;;
      -*) die "unknown flag $a" ;;
      *)
        if [ -z "$p" ]; then p=$a
        elif [ -z "$name" ]; then name=$a
        else die "usage: kuggis <cell> [name] [--agent claude|codex|pi] [--project NAME]"
        fi ;;
    esac
    shift
  done
  [ -n "$p" ] || die "usage: kuggis <cell> [name] [--agent claude|codex|pi] [--project NAME]"
  case $agent in ""|claude|codex|pi) ;; *) die "unknown agent '$agent' (claude, codex, pi)" ;; esac
  p=$(resolve_project "$p" "$selected") || return
  host=$(host_of "$p")
  if [ -z "$name" ]; then
    # shellcheck disable=SC2046
    set -- $(remote "$host" '~/.box/session.sh status' | cut -f1)
    case $# in
      0) die "no sessions on $p yet: kuggis $p <name>" ;;
      1) name=$1 ;;
      *) PS3="session: "; select name in "$@"; do [ -n "$name" ] && break; done ;;
    esac
  fi
  check_name "$name"
  python3 -I "$HERE/cellctl.py" guard "$p" "$name" || return
  # ssh exits 255 when the connection drops (sleep, network change, `~.`).
  # Once a session has been up a while, keep reattaching until it comes back;
  # a first attempt that fails fast is a real error and ends here.
  local rc t0 live=0
  while :; do
    t0=$(date +%s) rc=0
    ssh -t "${SSH_OPTS[@]}" "$host" "~/.box/session.sh attach $name $agent" || rc=$?
    [ "$rc" -eq 255 ] || return "$rc"
    [ $(($(date +%s) - t0)) -lt 30 ] || live=1
    [ "$live" = 1 ] || exit 255
    echo "kuggis: lost $host, reconnecting to $name (ctrl-c to stop)" >&2
    sleep 3
  done
}

cmd_done() {
  [ $# -ge 2 ] || die "usage: kuggis done <cell> <name> [--project NAME] [--force]"
  local p=$1 name=$2 selected='' force=''
  shift 2
  while [ $# -gt 0 ]; do
    case $1 in
      --project) [ $# -ge 2 ] || die "--project needs a name"; selected=$2; shift ;;
      --force) force=--force ;;
      *) die "unknown argument $1" ;;
    esac
    shift
  done
  check_name "$name"
  p=$(resolve_project "$p" "$selected") || return
  remote "$(host_of "$p")" "~/.box/session.sh done $name $force"
}

# Copy a file to ~/inbox on a VM; print its path there.
upload() {
  local host=$1 file=$2 base dest home
  base=$(basename "$file" | LC_ALL=C tr -c 'A-Za-z0-9._\n-' '_')
  dest=inbox/$(date +%Y%m%d-%H%M%S)-$base
  home=$(remote "$host" 'mkdir -p ~/inbox && echo $HOME' </dev/null)
  scp -q "${SSH_OPTS[@]}" "$file" "$host:$dest" </dev/null
  echo "$home/$dest"
}

cmd_put() {
  local file='' p='' s='' tmp='' dir path selected='' host args=()
  while [ $# -gt 0 ]; do
    case $1 in
      --project) [ $# -ge 2 ] || die "--project needs a name"; selected=$2; shift ;;
      *) args+=("$1") ;;
    esac
    shift
  done
  set -- ${args[@]+"${args[@]}"}
  # Positional, never guessed: a project or session can share a file's name.
  [ $# -le 3 ] || die "usage: kuggis put [cell [session [file]]] [--project NAME]"
  p=${1:-} s=${2:-} file=${3:-}
  [ -z "$file" ] || [ -f "$file" ] || die "no such file: $file"
  if [ -z "$p" ]; then
    # shellcheck disable=SC2046
    set -- $(projects)
    [ $# -eq 1 ] || die "which cell? kuggis put <cell> [session [file]] [--project NAME]"
    p=$1
  fi
  [ -z "$s" ] || check_name "$s"
  p=$(resolve_project "$p" "$selected") || return
  host=$(host_of "$p")
  if [ -z "$file" ]; then
    tmp=$(mktemp -d)
    trap "rm -rf '$tmp'" EXIT
    if osascript -e "set f to open for access POSIX file \"$tmp/clipboard.png\" with write permission" \
      -e 'write (the clipboard as «class PNGf») to f' -e 'close access f' >/dev/null 2>&1; then
      file=$tmp/clipboard.png
    else
      dir=$(defaults read com.apple.screencapture location 2>/dev/null || echo "$HOME/Desktop")
      dir=${dir/#\~/$HOME}
      file=$(ls -t "$dir"/Screen* 2>/dev/null | head -1 || true)
      [ -n "$file" ] || die "no file given, no image on the clipboard, no screenshot in $dir"
    fi
  fi
  path=$(upload "$host" "$file")
  if [ -n "$s" ]; then
    remote "$host" "tmux send-keys -t '=$s:' -l -- '$path '" ||
      die "uploaded $path, but could not type it into session $s"
    echo "typed into $p/$s: $path"
  else
    printf %s "$path" | pbcopy
    echo "copied: $path"
  fi
}

wait_ssh() {
  local i
  for i in $(seq 1 45); do
    ssh -o BatchMode=yes -o ConnectTimeout=5 -o StrictHostKeyChecking=accept-new "$1" true 2>/dev/null && return 0
    sleep 2
  done
  die "$1 never answered ssh"
}

cmd_new() {
  local p='' repo='' vm='' profile='' extra=()
  while [ $# -gt 0 ]; do
    case $1 in
      --vm) vm=$2; shift 2 ;;
      --profile) profile=$2; shift 2 ;;
      --cpu | --memory | --disk) extra+=("$1=$2"); shift 2 ;;
      -*) die "unknown flag $1" ;;
      *)
        if [ -z "$p" ]; then p=$1
        elif [ -z "$repo" ]; then repo=$1
        else die "usage: kuggis new <project> <owner/repo> [--vm NAME] [--profile NAME]"
        fi
        shift ;;
    esac
  done
  [ -n "$p" ] && [ -n "$repo" ] || die "usage: kuggis new <project> <owner/repo> [--vm NAME] [--profile NAME]"
  [[ $p =~ ^[a-z0-9][a-z0-9-]*$ ]] || die "project names are lowercase letters, digits and -"
  case $p in home | ls | cells | cell | dispatch | watch | url | think | new | sync | sh | put | done | token | help | onboard | reconcile | audit | adopt) die "'$p' is a kuggis command" ;; esac
  [[ $repo =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]] || die "repo must be owner/name"
  [ -z "$(row "$p")" ] || die "$p already exists in $MAP"
  vm=${vm:-$p}
  [[ $vm =~ ^[a-z0-9][a-z0-9-]*$ ]] || die "VM names are lowercase letters, digits and -"
  profile=${profile:-$p}
  [ -f "$HERE/profiles/$profile.sh" ] || profile=-
  token >/dev/null
  remote exe.dev integrations setup github --list | grep -q 'No GitHub accounts' &&
    die "link GitHub to exe.dev first: ssh exe.dev integrations setup github"

  echo "creating VM ${vm}…"
  remote exe.dev "new --name=$vm --tag=box --no-email --comment=box:$repo ${extra[*]+${extra[*]}}"
  echo "granting $vm access to ${repo}…"
  # As exe.dev's scoped bot, not as you. The cell contract determines which
  # checks and reviews must pass before GitHub allows it to merge.
  remote exe.dev "integrations add github --name=gh-$vm --repository=$repo --attach=vm:$vm"
  # Shut the VM's outbound email gateway: a box must not be able to mail anyone,
  # owner included (no phishing channel). Inbound was already off (--no-email).
  echo "shutting outbound email on ${vm}…"
  remote exe.dev "share receive-email $vm --reply-policy=none" >/dev/null
  mkdir -p "$CONF"
  echo "$p $vm $repo $profile" >>"$MAP"
  wait_ssh "$vm.exe.xyz"
  sync_one "$p"
  echo "ready: kuggis $p <session-name>"
}

sync_one() {
  local p=$1 r vm repo profile host
  r=$(row "$p")
  [ -n "$r" ] || die "unknown project '$p'"
  read -r _ vm repo profile <<<"$r"
  host=$vm.exe.xyz
  # Validate policy ownership before changing anything on the destination.
  local cell_contract cell_notes
  cell_contract=$(python3 -I "$HERE/cellctl.py" export "$p" contract) || return
  cell_notes=$(python3 -I "$HERE/cellctl.py" export "$p" instructions) || return
  echo "syncing $p ($host)…"
  COPYFILE_DISABLE=1 tar --no-xattrs -C "$HERE/vm" -cf - . |
    remote "$host" 'mkdir -p ~/.box && tar -C ~/.box -xf - 2>/dev/null'
  if [ "$profile" != - ]; then
    remote "$host" 'cat >~/.box/profile.sh' <"$HERE/profiles/$profile.sh"
  else
    remote "$host" 'rm -f ~/.box/profile.sh'
  fi
  # Agent notes for this project, appended to kuggis's CLAUDE.md block.
  if [ "$profile" != - ] && [ -f "$HERE/profiles/$profile.md" ]; then
    remote "$host" 'cat >~/.box/profile.md' <"$HERE/profiles/$profile.md"
  else
    remote "$host" 'rm -f ~/.box/profile.md'
  fi
  # Per-project secrets (KEY=value lines), exported into every session.
  local secrets=$CONF/secrets/$p.env
  if [ -f "$secrets" ]; then
    [ "$(stat -f %Lp "$secrets")" = 600 ] || echo "kuggis: warning: $secrets is readable by others (chmod 600 it)" >&2
    remote "$host" 'umask 077 && cat >~/.box/secrets.env' <"$secrets"
  else
    remote "$host" 'rm -f ~/.box/secrets.env'
  fi
  token | remote "$host" 'umask 077 && cat >~/.box/token'
  {
    printf 'BOX_PROJECT=%q\n' "$p"
    printf 'BOX_REPO=%q\n' "$repo"
    printf 'BOX_MODE=%q\n' "${BOX_MODE:-auto}"
    printf 'BOX_NTFY=%q\n' "$(cat "$CONF/ntfy" 2>/dev/null || true)"
    printf 'BOX_GIT_NAME=%q\n' "$(git config --global user.name)"
    printf 'BOX_GIT_EMAIL=%q\n' "$(git config --global user.email)"
    # Sessions use the same model and effort as Claude on this laptop.
    printf 'BOX_CLAUDE_PREFS=%q\n' "$(jq -c '{model, effortLevel, alwaysThinkingEnabled}
      | with_entries(select(.value != null))' ~/.claude/settings.json 2>/dev/null || echo '{}')"
  } | remote "$host" 'cat >~/.box/config'
  # Derive VM policy and instructions from the single private cell contract.
  if [ -n "$cell_contract" ]; then
    printf '%s\n' "$cell_contract" | remote "$host" 'cat >~/.box/cell-contract.json'
    printf '%s\n' "$cell_notes" | remote "$host" 'cat >~/.box/cell-instructions.md'
  else
    remote "$host" 'rm -f ~/.box/cell-contract.json ~/.box/cell-instructions.md'
  fi
  remote "$host" 'bash ~/.box/bootstrap.sh'
}

cmd_sync() {
  local p='' selected=''
  if [ $# -eq 0 ]; then
    for p in $(projects); do sync_one "$p"; done
    return
  fi
  p=$1; shift
  if [ "${1:-}" = --project ]; then
    [ $# -ge 2 ] || die "--project needs a name"
    selected=$2; shift 2
  fi
  [ $# -eq 0 ] || die "usage: kuggis sync [cell] [--project NAME]"
  p=$(resolve_project "$p" "$selected") || return
  sync_one "$p"
}

cmd_sh() {
  local host p=$1 selected=''; shift
  if [ "${1:-}" = --project ]; then
    [ $# -ge 2 ] || die "--project needs a name"
    selected=$2; shift 2
  fi
  [ "${1:-}" != -- ] || shift
  p=$(resolve_project "$p" "$selected") || return
  host=$(host_of "$p")
  exec ssh -t "${SSH_OPTS[@]}" "$host" "$@"
}

cmd_token() {
  echo "kuggis: a browser opens for the Claude sign-in; copy the token it prints."
  claude setup-token
  local t
  printf 'kuggis: paste the token (hidden): '
  read -rs t
  echo
  t=$(printf %s "$t" | tr -d '[:space:]')
  [[ $t == sk-ant-* ]] || die "that doesn't look like a Claude token"
  security add-generic-password -U -a "$USER" -s "$KEYCHAIN_SERVICE" -w "$t"
  echo "kuggis: stored. Push it to your VMs with: kuggis sync"
}

# ── The door ─────────────────────────────────────────────────────────────────
# The Thinker's room (kuggis think) has one way out: requests it writes to its
# outbox, each with a front-matter `kind`. kuggis carries them by kind:
#   brief   waits for you, then goes into a session (kuggis dispatch)
#   search  goes; the URLs it returns become known
#   fetch   goes if its URL is known (a search returned it, or you gave it
#           with kuggis url); otherwise waits for you
# The answer is a reply in the room's inbox named by the request's hash, and
# every decision is logged with that hash, so a request that changes after
# you saw it shows up again. think/door.py defines the format and serves the
# room's side of it as MCP tools; kuggis watch is the carrier.
OUTBOX=${KUGGIS_OUTBOX:-/Users/thinker/workspace/outbox}
ROOM_INBOX=${KUGGIS_ROOM_INBOX:-/Users/thinker/workspace/inbox}
DLOG=$CONF/dispatch.log # time, decision, sha256, request, target
KNOWN_URLS=$CONF/known-urls
# The search backend's key lives with the other per-place secrets.
door() { (set -a; [ ! -f "$CONF/secrets/thinker.env" ] || . "$CONF/secrets/thinker.env"; set +a; exec python3 -I "$HERE/think/door.py" "$@"); }

sha() { shasum -a 256 "$1" | cut -d' ' -f1; }

# Text from the room or a VM (requests, reviews, run logs, PR titles), made safe
# to print: control characters other than tab and newline, C1 included, show
# as \xNN, so nothing in it can recolour, hide or overwrite what you're
# reading. Bytes, not characters: invalid UTF-8 can't cut the text short.
room_text() {
  perl -pe 's/([\x00-\x08\x0b-\x1f\x7f])/sprintf("\\x%02x", ord $1)/ge; s/\xc2([\x80-\x9f])/sprintf("\\x%02x", ord $1)/ge' "$@"
}

# One key from the person (a line when stdin isn't a terminal, as in tests).
ask() {
  local k=''
  if [ -t 0 ]; then read -rsn1 k; else read -r k || k=q; fi
  printf '%s' "$k"
}

# A key from a request's front matter (between --- lines at the top).
field() {
  awk -v k="$2" 'NR == 1 { if ($0 != "---") exit; next } $0 == "---" { exit }
    { i = index($0, ":"); if (i && substr($0, 1, i - 1) == k) {
      v = substr($0, i + 1); gsub(/^[ \t]+|[ \t\r]+$/, "", v); print v; exit } }' "$1"
}
request_kind() { local k; k=$(field "$1" kind); echo "${k:-brief}"; } # a hand-written brief has no kind

# What in a request could be data on its way out: URLs, long opaque strings,
# invisible characters, an odd size. A guide for your read, not a verdict.
request_flags() {
  perl -CSD -ne '
    while (m{(https?://[^\s<>")\]]+)}g) { print "url     line $.: $1\n" }
    (my $l = $_) =~ s{https?://\S+}{}g;
    while ($l =~ m{([A-Za-z0-9+/=_-]{40,})}g) { print "opaque  line $.: " . substr($1, 0, 48) . "...\n" }
    print "hidden  line $.: invisible or direction-changing characters\n"
      if /[\x{200B}-\x{200F}\x{202A}-\x{202E}\x{2060}-\x{2064}\x{FEFF}]/;
    print "control line $.: terminal control characters (shown as \\xNN)\n"
      if /[\x00-\x08\x0b-\x1f\x7f-\x9f]/;
  ' "$1" 2>/dev/null || echo "unreadable as UTF-8"
  local n; n=$(wc -c <"$1" | tr -d ' ')
  [ "$n" -le 20000 ] || echo "size    $n bytes: long for a request"
}

# Requests not yet decided, oldest first, optionally of one kind. A name that
# isn't plain is skipped: it came from the Thinker, so it's data, not a path.
pending_requests() { # pending_requests [kind]
  [ -d "$OUTBOX" ] || return 0
  local f
  ls -tr "$OUTBOX" 2>/dev/null | while IFS= read -r f; do
    [[ $f =~ ^[A-Za-z0-9._-]+\.md$ ]] && [ -f "$OUTBOX/$f" ] || continue
    [ -z "$(field "$OUTBOX/$f" review)" ] || continue # a PR review, not a request
    [ -z "${1:-}" ] || [ "$(request_kind "$OUTBOX/$f")" = "$1" ] || continue
    grep -q "$(sha "$OUTBOX/$f")" "$DLOG" 2>/dev/null || echo "$OUTBOX/$f"
  done
}

url_known() { [ -n "$1" ] && grep -qxF -- "$1" "$KNOWN_URLS" 2>/dev/null; }

# Is this request yours to decide? Briefs always; a fetch nothing vouched for.
held() { # held <request>
  case $(request_kind "$1") in
    brief) return 0 ;;
    fetch) ! url_known "$(field "$1" url)" ;;
    *) return 1 ;;
  esac
}
held_requests() { local f; for f in $(pending_requests); do ! held "$f" || echo "$f"; done; }

# Record a decision: a line in the log, and the reply the room reads.
decide() { # decide <status> <request> <target> [<body file>]
  [ -z "${KUGGIS_DRY_RUN:-}" ] || return 0
  local id now
  id=$(sha "$2") now=$(date -u +%Y-%m-%dT%H:%M:%SZ)
  mkdir -p "$CONF"
  printf '%s\t%s\t%s\t%s\t%s\n' "$now" "$1" "$id" "$(basename "$2")" "$3" >>"$DLOG"
  [[ $2 == "$OUTBOX"/* ]] && [ -w "$ROOM_INBOX" ] || return 0
  mkdir -p "$ROOM_INBOX/replies"
  {
    printf -- '---\nstatus: %s\nrequest: %s\nat: %s\n---\n' "${1%% *}" "$(basename "$2")" "$now"
    [ -z "${4:-}" ] || cat "$4"
  } >"$ROOM_INBOX/replies/.$id.tmp"
  chmod a+r "$ROOM_INBOX/replies/.$id.tmp"
  mv "$ROOM_INBOX/replies/.$id.tmp" "$ROOM_INBOX/replies/$id.md"
}

# Where a brief goes: "project<tab>session<tab>agent", resolving a cell to its
# project; or the problem, on stderr.
brief_target() {
  local c p s a
  c=$(field "$1" cell) p=$(field "$1" project) s=$(field "$1" session) a=$(field "$1" agent)
  a=${a:-claude}
  if [ -n "$c" ]; then p=$(resolve_project "$c" "$p") || return 1
  elif [ -z "$p" ] || [ -z "$(row "$p")" ]; then
    echo "project '$p' isn't one of yours: $(projects | tr '\n' ' ')" >&2; return 1
  fi
  [[ $s =~ ^[A-Za-z0-9][A-Za-z0-9_-]*$ ]] || { echo "session '$s' isn't a valid name" >&2; return 1; }
  case $a in claude | codex | pi) ;; *) echo "agent '$a' isn't claude, codex or pi" >&2; return 1 ;; esac
  printf '%s\t%s\t%s\n' "$p" "$s" "$a"
}
brief_problem() { brief_target "$1" 2>&1 >/dev/null || true; }

# Hand a brief to its session: upload it and have the VM start the session with
# it, or type it into the session if it's already running.
dispatch_brief() { # dispatch_brief <file> <project> <session> <agent>
  local host dest
  host=$(host_of "$2")
  python3 -I "$HERE/cellctl.py" guard "$2" "$3" || return
  # </dev/null throughout: ssh would otherwise read the keys meant for the next request.
  remote "$host" 'grep -q "^  deliver)" ~/.box/session.sh' </dev/null ||
    die "$2's VM predates dispatch: kuggis sync $2"
  dest=$(upload "$host" "$1")
  remote "$host" "~/.box/session.sh deliver $3 $4 $dest" </dev/null
}

# Carry one request: a brief into its session, a search to the backend, a fetch
# to its page. <edited> is your copy of a brief, when you made one. The reply
# carries the answer, or why it was refused.
carry_one() { # carry_one <request> [<edited copy>]
  local orig=$1 f=${2:-$1} kind target p s a out err rc=0
  kind=$(request_kind "$orig") out=$(mktemp) err=$(mktemp)
  case $kind in
    brief)
      if target=$(brief_target "$f" 2>"$err"); then
        IFS=$'\t' read -r p s a <<<"$target"
        if dispatch_brief "$f" "$p" "$s" "$a"; then
          echo "attach with: kuggis $p $s" | tee "$out"
          decide "$([ "$f" = "$orig" ] && echo sent || echo edited)" "$orig" "$p/$s/$a" "$out"
        else rc=1; fi
      else echo "can't dispatch: $(cat "$err"). [e]dit it first."; rc=1; fi ;;
    search)
      if door search "$(field "$orig" query)" --remember "$KNOWN_URLS" >"$out" 2>"$err"; then decide done "$orig" search "$out"
      else decide refused "$orig" search "$err"; fi ;;
    fetch)
      if door fetch "$(field "$orig" url)" >"$out" 2>"$err"; then decide done "$orig" "$(field "$orig" url)" "$out"
      else decide refused "$orig" "$(field "$orig" url)" "$err"; fi ;;
    *) echo "unknown kind '$kind'" >"$err"; decide refused "$orig" "$kind" "$err" ;;
  esac
  rm -f "$out" "$err"
  return $rc
}

# The rule, applied: open requests go now; held ones wait for you.
carry() {
  local f
  for f in $(pending_requests); do
    held "$f" && continue
    echo "$(date +%H:%M:%S) $(request_kind "$f") $(basename "$f")"
    carry_one "$f" >/dev/null || true
  done
}

# A request as you review it: where it goes, what to look at, then all of it.
request_view() { # request_view <file> [<original, if this is your edit>]
  local f=$1 orig=${2:-$1} kind target
  kind=$(request_kind "$f")
  echo "$(printf '%-8s' "$kind") $(basename "$orig")$([ "$f" = "$orig" ] || echo '  (your edit)')"
  case $kind in
    brief)
      if target=$(brief_target "$f" 2>/dev/null); then
        echo "goes to  $(cut -f1 <<<"$target") / $(cut -f2 <<<"$target") ($(cut -f3 <<<"$target"))"
      else echo "PROBLEM  $(brief_problem "$f")"; fi ;;
    fetch)
      echo "fetches  $(field "$f" url | room_text)"
      echo "         no search here returned this URL, so it waits for you" ;;
    *) echo "PROBLEM  unknown kind '$kind'" ;;
  esac
  echo "look at  (anything that could carry data out)"
  request_flags "$f" | sed 's/^/  /' | grep . || echo "  nothing unusual"
  echo "────────────────────────────────────────────────────────────"
  room_text "$f"
}

# Show a held request, then decide: a brief is [d]ispatched, [e]dited, [s]kipped
# or [r]ejected; a fetch is [d]one now, [s]kipped or [r]ejected. Returns 1 to quit.
review_request() {
  local orig=$1 f=$1 key kind view
  kind=$(request_kind "$orig")
  while :; do
    view=$(mktemp)
    request_view "$f" "$orig" >"$view"
    if [ -t 1 ]; then ${KUGGIS_PAGER:-less -RFX} "$view"; else cat "$view"; fi
    rm -f "$view"
    if [ "$kind" = brief ]; then printf '\n[d]ispatch  [e]dit  [s]kip  [r]eject  [q]uit: '
    else printf '\n[d]o it  [s]kip  [r]eject  [q]uit: '; fi
    key=$(ask)
    echo "$key"
    case $key in
      d) carry_one "$orig" "$f" && return 0 ;;
      e)
        [ "$kind" = brief ] || continue
        if [ "$f" = "$orig" ]; then
          mkdir -p "$CONF/dispatch"
          f=$CONF/dispatch/$(date +%Y%m%d-%H%M%S)-$(basename "$orig")
          cp "$orig" "$f"
        fi
        ${EDITOR:-vi} "$f" </dev/tty >/dev/tty ;;
      s) return 0 ;;
      r) decide rejected "$orig" "$kind"; echo "rejected"; return 0 ;;
      *) return 1 ;;
    esac
  done
}

# ── One picture of everything ────────────────────────────────────────────────
# Projects, every session with its last screen, the room's pending requests
# and (when the carrier gathers it) open PRs, as JSON for cells/display.py.
# Cached for 20s in $CONF/snapshot.json so the home screen and the watcher share
# one round of ssh. The home never asks GitHub: opening it must cost nothing.
snapshot() { # snapshot [--fresh]
  local cache=$CONF/snapshot.json
  if [ "${1:-}" != --fresh ] && [ -f "$cache" ] && [ $(($(date +%s) - $(stat -f %m "$cache"))) -lt 20 ]; then
    cat "$cache"
    return
  fi
  mkdir -p "$CONF"
  gather_snapshot "${1:-}" >"$cache.tmp" && mv "$cache.tmp" "$cache"
  cat "$cache"
}

gather_snapshot() { # gather_snapshot [--fresh: ask GitHub for PRs too]
  local p tmp f
  tmp=$(mktemp -d)
  for p in $(projects); do
    (remote "$(host_of "$p")" '~/.box/session.sh snapshot 2>/dev/null || ~/.box/session.sh status' >"$tmp/$p" 2>/dev/null ||
      printf -- '-\tunreachable\t-\n' >"$tmp/$p") &
  done
  wait
  {
    [ ! -f "$MAP" ] || awk 'NF && $1 !~ /^#/ { print "project\t" $1 "\t" $4 }' "$MAP"
    for p in $(projects); do
      # status rows until `--`, then each session's screen, base64 on one line
      awk -F'\t' -v p="$p" 'BEGIN { OFS = "\t" } /^--$/ { s = 1; next } !s { print "session", p, $0 } s { print "screen", p, $1, $2 }' "$tmp/$p"
      [ -s "$tmp/$p" ] || printf 'session\t%s\t-\tno sessions\t-\n' "$p"
    done
    [ "${1:-}" != --fresh ] || prs_tsv | awk -F'\t' 'BEGIN { OFS = "\t" } { print "pr", $1, $2, $3, $4, $8, $9 }'
    for f in $(pending_requests); do
      printf 'request\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$(sha "$f")" "$(request_kind "$f")" "$(field "$f" cell)" \
        "$(field "$f" project)" "$(field "$f" session)" "$(field "$f" url)" "$(stat -f %m "$f")" "$(held "$f" && echo 1 || echo 0)"
    done
    [ ! -x /opt/kuggis-thinker/launch ] || printf 'thinker\n'
    true
  } | room_text | jq -Rn '[inputs | split("\t")] as $rows
    | ($rows | map(select(.[0] == "screen") | {key: (.[1] + "/" + .[2]), value: (try (.[3] | @base64d) catch "")}) | from_entries) as $screens
    | {projects: [$rows[] | select(.[0] == "project") | {name: .[1], profile: .[2]}],
       sessions: [$rows[] | select(.[0] == "session") | {project: .[1], name: .[2], state: .[3], age: .[4], screen: ($screens[.[1] + "/" + .[2]] // "")}],
       prs: [$rows[] | select(.[0] == "pr") | {project: .[1], repo: .[2], n: (.[3] | tonumber), branch: .[4], checks: .[5], title: .[6]}],
       requests: [$rows[] | select(.[0] == "request") | {id: .[1], kind: .[2], cell: .[3], project: .[4], session: .[5], url: .[6], since: (.[7] | tonumber), held: (.[8] == "1")}],
       thinker_installed: any($rows[]; .[0] == "thinker"), now: (now | floor)}'
  rm -rf "$tmp"
}

# What the room may know, written to its inbox as state.json: the snapshot,
# grouped by cell, with the open PRs.
room_state() {
  [ -d "$ROOM_INBOX" ] && [ -w "$ROOM_INBOX" ] || return 0
  snapshot --fresh | cell_tool json >"$ROOM_INBOX/.state.json.tmp" || { rm -f "$ROOM_INBOX/.state.json.tmp"; return 0; }
  chmod a+r "$ROOM_INBOX/.state.json.tmp"
  mv "$ROOM_INBOX/.state.json.tmp" "$ROOM_INBOX/state.json"
}

# The room's only road out: a CONNECT proxy on loopback that tunnels to the
# hosts in think/hosts (plus ~/.config/kuggis/thinker-hosts) and refuses the
# rest. Started here so the room has a road exactly while kuggis watches.
PROXY_PORT=${KUGGIS_PROXY_PORT:-4749}
start_proxy() {
  ! nc -z 127.0.0.1 "$PROXY_PORT" 2>/dev/null || return 0
  python3 -I "$HERE/think/proxy.py" "$PROXY_PORT" "$HERE/think/hosts" "$CONF/thinker-hosts" &
  # shellcheck disable=SC2064 # expand now
  trap "kill $! 2>/dev/null" EXIT
}

# kuggis watch: keep the room's inbox fresh and carry its requests, every few
# seconds, until stopped. The cockpit (kuggis think) runs it for you.
cmd_watch() {
  case ${1:-} in '' | --once) ;; *) die "usage: kuggis watch [--once]" ;; esac
  [ "${1:-}" = --once ] || start_proxy
  while :; do
    room_state
    carry
    [ "${1:-}" != --once ] || return 0
    sleep "${KUGGIS_WATCH_INTERVAL:-10}"
  done
}

# kuggis url <link>: vouch for a URL yourself, so the room's next fetch of it goes.
cmd_url() {
  [ $# -eq 1 ] && [[ $1 =~ ^https?://[^[:space:]]+$ ]] || die "usage: kuggis url <http(s) link>"
  mkdir -p "$CONF"
  url_known "$1" || printf '%s\n' "$1" >>"$KNOWN_URLS"
  echo "known: $1"
}

cmd_dispatch() {
  case ${1:-} in
    --status) room_state; echo "kuggis: wrote $ROOM_INBOX/state.json"; return ;;
    '') ;;
    *) die "usage: kuggis dispatch [--status]" ;;
  esac
  local f n=0
  for f in $(held_requests); do
    n=$((n + 1))
    review_request "$f" || break
  done
  [ "$n" -gt 0 ] || echo "kuggis: nothing waiting for you in $OUTBOX"
  room_state
}

# ── Pull requests ────────────────────────────────────────────────────────────
# Open PRs on each project's repo, for the snapshot the room reads. Merges
# happen inside the cells, by their contract; kuggis only looks.
CHECKS_JQ='([.statusCheckRollup[]? | (.conclusion // .state // "") as $r
  | if ((.status? // "COMPLETED") != "COMPLETED") or $r == "PENDING" or $r == "" then "pending"
    elif ($r | test("SUCCESS|NEUTRAL|SKIPPED")) then "ok" else "failing" end]
  | if length == 0 then "none" elif index("failing") then "failing"
    elif index("pending") then "pending" else "ok" end)'

# project, repo, number, head branch, head commit, base, author, checks, title (tab-separated)
prs_tsv() {
  local p repo tmp
  tmp=$(mktemp -d)
  for p in $(projects); do
    repo=$(row "$p" | awk '{ print $3 }')
    (gh pr list -R "$repo" --state open --limit 30 \
      --json number,title,headRefName,headRefOid,baseRefName,author,statusCheckRollup \
      --jq ".[] | [\"$p\", \"$repo\", .number, .headRefName, .headRefOid, .baseRefName, .author.login,
        $CHECKS_JQ, (.title | gsub(\"\\t\"; \" \"))] | @tsv" >"$tmp/$p" 2>/dev/null || true) &
  done
  wait
  for p in $(projects); do cat "$tmp/$p" 2>/dev/null || true; done
  rm -rf "$tmp"
}

# Run, or with KUGGIS_DRY_RUN=1 only say what would run.
act() { if [ -n "${KUGGIS_DRY_RUN:-}" ]; then echo "would run: $*"; else "$@"; fi; }

# ── The home screen with fzf ─────────────────────────────────────────────────
# One list by cell (sessions, waiting requests, PRs), a live preview of the
# highlighted item (a session's current screen), Enter to act on it.
# It refreshes itself every 15s through fzf's control socket, which lives in a
# folder only you can enter and takes a random key: the thinker user can reach
# your localhost, and must not be able to drive this.

# The list: kind, what you see, then the item's data (tab-separated).
# Close a session: kuggis done, which refuses to throw work away (uncommitted
# changes, or commits on no remote without a merged PR). --force stays a
# command you type.
close_session() { # close_session <project> <session>
  printf 'close %s / %s? [y/N] ' "$1" "$2"
  [ "$(ask)" = y ] || { echo; return 0; }
  echo
  act cmd_done "$1" "$2" </dev/null && return 0
  printf '\nleft open (kuggis done %s %s --force discards its work). any key: ' "$1" "$2"
  ask >/dev/null
  echo
}

home_close() { # home_close <item line>
  local kind _ p s
  IFS=$'\t' read -r kind _ p s <<<"$1"
  [ "$kind" != session ] || close_session "$p" "$s"
}

home_preview() { # home_preview <item line>
  local kind _ p s rows
  IFS=$'\t' read -r kind _ p s <<<"$1"
  case $kind in
    vm) echo "$p: its VM didn't answer ssh. kuggis sh $p to look; kuggis ls to retry." ;;
    session)
      rows=${FZF_PREVIEW_LINES:-40}
      echo "$p / $s · enter attaches"
      remote "$(host_of "$p")" "tmux capture-pane -e -p -t '=$s:' 2>/dev/null" </dev/null |
        awk '{ l[NR] = $0 } /[^ ]/ { last = NR } END { for (i = 1; i <= last; i++) print l[i] }' |
        tail -n $((rows - 1)) ;;
  esac
}

cell_items() { snapshot | cell_tool items --color; }

cell_preview() {
  local kind _ p s
  IFS=$'\t' read -r kind _ p s <<<"$1"
  case $kind in
    cell) cell_tool definition "$p" ;;
    thinker) echo 'kuggis think' ;;
    setup) echo "kuggis audit $p" ;;
    door) echo 'kuggis dispatch — a request from the Thinker waits for your decision' ;;
    pr) echo "$p#$s · enter opens it on GitHub" ;;
    *) home_preview "$1" ;;
  esac
}

cell_act() {
  local kind _ p s
  IFS=$'\t' read -r kind _ p s <<<"$1"
  case $kind in
    cell) cell_tool definition "$p" ;;
    thinker) "$HERE/kuggis" think ;;
    setup) python3 -I "$HERE/cellctl.py" audit "$p" ;;
    door) cmd_dispatch ;;
    pr) gh pr view "$s" -R "$p" --web >/dev/null 2>&1 ;;
    session) cmd_attach "$p" "$s" ;;
    vm) "$HERE/kuggis" sh "$p" ;;
  esac
}

cmd_cell_home() {
  local line choice i rows=()
  while :; do
    rows=()
    # Capture first so a broken definition reports its error instead of a
    # process-substitution failure looking like an empty session list.
    local items; items=$(cell_items) || return
    while IFS= read -r line; do [ -z "$line" ] || rows+=("$line"); done <<<"$items"
    i=0
    for line in ${rows[@]+"${rows[@]}"}; do
      i=$((i + 1)); printf '%2d  %s\n' "$i" "$(cut -f2 <<<"$line")"
    done
    printf '\npick a number, x<number> to close a session, [r]efresh, [q]uit: '
    read -r choice || return 0
    case $choice in
      q | '') return 0 ;;
      r) continue ;;
      x[0-9]*)
        choice=${choice#x}
        [[ $choice =~ ^[0-9]+$ ]] && [ "$choice" -ge 1 ] && [ "$choice" -le ${#rows[@]} ] || continue
        home_close "${rows[$((choice - 1))]}" || true
        continue ;;
      *[!0-9]*) continue ;;
    esac
    [ "$choice" -ge 1 ] && [ "$choice" -le ${#rows[@]} ] || continue
    cell_act "${rows[$((choice - 1))]}" || true
  done
}

cmd_fzf_home() {
  local self=$HERE/kuggis dir sock tick items=_cell_items preview=_cell_preview action=_cell_act
  local header='enter open · ctrl-x close a session · ctrl-r refresh · esc quit'
  dir=$(mktemp -d /tmp/kuggis.XXXXXX) # mode 700, and short: socket paths are capped at 104 bytes
  sock=$dir/home.sock
  FZF_API_KEY=$(openssl rand -hex 16)
  export FZF_API_KEY
  (
    # Refresh the list and the preview every 15s while fzf runs.
    while sleep 15; do
      [ -S "$sock" ] || continue
      curl -sf --unix-socket "$sock" -XPOST -H "x-api-key: $FZF_API_KEY" http://localhost \
        -d "reload-sync($self $items)+refresh-preview" >/dev/null || break
    done
  ) &
  tick=$!
  disown "$tick" 2>/dev/null || true
  # shellcheck disable=SC2064 # expand now: these are locals
  trap "kill $tick 2>/dev/null; rm -rf '$dir'" EXIT
  trap 'exit 129' HUP TERM # a closed terminal still cleans up
  "$self" "$items" | fzf --ansi --listen="$sock" --delimiter=$'\t' --with-nth=2 --id-nth=1,3,4,5 \
    --layout=reverse --no-sort --info=hidden --prompt='kuggis › ' \
    --header="$header" \
    --preview="$self $preview {}" --preview-window='right,60%,wrap' \
    --bind="enter:execute($self $action {})+reload-sync($self $items)+refresh-preview" \
    --bind="ctrl-x:execute($self _close {})+reload-sync($self $items)+refresh-preview" \
    --bind="ctrl-r:reload-sync($self $items)+refresh-preview" || true
}

# The Thinker's room (think/README.md): a separate macOS user running Claude
# Code restricted, entered through a root-owned launcher.
cmd_think() {
  local room=/opt/kuggis-thinker
  cd / # the thinker user can't enter your folders; don't start it in one
  case ${1:-} in
    --setup)
      local bin token
      bin=$(readlink -f "$(command -v claude)") || die "no claude on PATH"
      token=$(security find-generic-password -s "$KEYCHAIN_SERVICE" -w 2>/dev/null) || die "no Claude token yet: kuggis token"
      [ "$(id -u)" != 0 ] || die "run kuggis think --setup as yourself, without sudo: it asks for sudo when it needs it"
      echo "kuggis: building the Thinker's room (sudo asks for your password)"
      printf '%s' "$token" | sudo "$HERE/think/setup.sh" "$USER" "$bin" "$CONF/secrets/thinker.env"
      ;;
    --check)
      sudo -u thinker "$room/check" "$USER" || true
      echo
      echo "kuggis: now the tool-level half. Paste this into a Thinker session (kuggis think);"
      echo "        it should report each step as expected, refusals included:"
      echo
      sed "s|/Users/OWNER|/Users/$USER|" "$room/check-prompt.md"
      ;;
    "" | -*)
      [ -x "$room/launch" ] || die "no Thinker room yet: kuggis think --setup"
      cockpit "$@" ;;
    *) die "usage: kuggis think [--setup|--check|<claude flags>]" ;;
  esac
}

# The cockpit: the Thinker's chat, with kuggis watch carrying its requests and
# the home screen one window over (C-b n) showing what waits for you. The bar
# turns orange when something does. Without tmux (brew install tmux) the chat
# runs alone, the watcher behind it.
cockpit() {
  local room=/opt/kuggis-thinker self=$HERE/kuggis
  if ! command -v tmux >/dev/null; then
    "$self" watch >"$CONF/watch.log" 2>&1 &
    # shellcheck disable=SC2064 # expand now
    trap "kill $! 2>/dev/null" EXIT
    echo "kuggis: watching in the background (log: $CONF/watch.log); decide requests with: kuggis dispatch" >&2
    sudo -u thinker "$room/launch" "$@"
    return
  fi
  if ! tmux has-session -t =thinker 2>/dev/null; then
    tmux new-session -d -s thinker -n chat "sudo -u thinker $room/launch $*"
    tmux new-window -d -t =thinker -n kuggis "$self"
    tmux new-window -d -t =thinker -n watch "$self watch"
    tmux set-option -t =thinker status-interval 5 \; \
      set-option -t =thinker status-right "#($self _waiting)" \; \
      set-option -t =thinker status-right-length 40
  fi
  exec tmux attach-session -t =thinker
}

# For the cockpit's bar: how many requests wait for you, loud when any do.
waiting_badge() {
  local n; n=$(held_requests | grep -c . || true)
  [ "$n" -gt 0 ] || { printf 'nothing waiting '; return; }
  printf '#[fg=colour16,bg=colour214,bold] ⚑ %s waiting · C-b n #[default]' "$n"
}

case ${1:-home} in
  onboard | reconcile | audit | adopt) exec python3 -I "$HERE/cellctl.py" "$@" ;;
  home)
    if ! [ -t 0 ] || ! [ -t 1 ]; then cmd_ls
    elif command -v fzf >/dev/null; then cmd_fzf_home
    else cmd_cell_home
    fi ;;
  cells) [ $# -eq 1 ] || die "usage: kuggis cells"; cell_tool inventory ;;
  cell) [ $# -eq 2 ] || die "usage: kuggis cell <cell>"; cell_tool definition "$2" ;;
  _cell_items) cell_items ;;
  _snapshot) snapshot ;;
  _cell_preview) cell_preview "$2" ;;
  _cell_act) cell_act "$2" ;;
  _close) home_close "$2" ;;
  ls) shift; cmd_ls "$@" ;;
  dispatch) shift; cmd_dispatch "$@" ;;
  watch) shift; cmd_watch "$@" ;;
  url) shift; cmd_url "$@" ;;
  _waiting) waiting_badge ;;
  new) shift; cmd_new "$@" ;;
  sync) shift; cmd_sync "$@" ;;
  done) shift; cmd_done "$@" ;;
  put) shift; cmd_put "$@" ;;
  sh) shift; [ $# -ge 1 ] || die "usage: kuggis sh <cell> [--project NAME] [cmd...]"; cmd_sh "$@" ;;
  token) cmd_token ;;
  think) shift; cmd_think "$@" ;;
  help | -h | --help) sed -n '2,/^set -e/p' "$SELF" | sed '$d; s/^# \{0,1\}//' ;;
  --agent | --pi | --codex | --claude) cmd_attach "$@" ;;
  -*) die "unknown flag $1 (kuggis help)" ;;
  *) cmd_attach "$@" ;;
esac
