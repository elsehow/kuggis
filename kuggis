#!/usr/bin/env bash
# kuggis — Claude Code sessions on exe.dev VMs. One VM per project; one
# session per name, which is a tmux session plus a git worktree on the VM.
#
#   kuggis                           what's waiting on you: the Thinker's briefs,
#                                    open PRs with its reviews, every session;
#                                    pick one to dispatch, merge or attach
#   kuggis ls                        list every session on every VM
#   kuggis dispatch [--status]       review the Thinker's briefs one by one;
#                                    --status only refreshes what it can read
#   kuggis <project> [name] [--codex]
#                                    attach to a session, starting it if needed;
#                                    --codex starts Codex instead of Claude
#   kuggis done <project> <name> [--force]
#                                    end a session and remove its worktree
#   kuggis put [project] [session] [file]
#                                    upload a file (default: the clipboard image,
#                                    else your latest screenshot) to ~/inbox on
#                                    the VM; types the path into the session if
#                                    one is named, else copies it
#   kuggis new <project> <owner/repo> [--vm NAME] [--profile NAME]
#           [--cpu N] [--memory M] [--disk D]
#                                    create the VM, grant it the repo, set it up
#   kuggis sync [project]            push scripts, token, settings and secrets
#                                    (~/.config/kuggis/secrets/<project>.env) again
#   kuggis sh <project> [cmd...]     plain ssh to the VM
#   kuggis token                     mint a Claude token into the keychain
#   kuggis think [--setup|--check]   the Thinker: Claude Code in a contained room
#                                    on this laptop (think/README.md)
set -euo pipefail

CONF=${KUGGIS_CONFIG:-$HOME/.config/kuggis}
MAP=$CONF/vms # one line per project: <project> <vm> <owner/repo> <profile|->
SELF=$0
[ -L "$SELF" ] && SELF=$(readlink "$SELF")
HERE=$(cd "$(dirname "$SELF")" && pwd)
KEYCHAIN_SERVICE=box-claude-token
# Keepalives make a connection frozen by sleep give up ~45s after wake.
SSH_OPTS=(-o BatchMode=yes -o ConnectTimeout=10 -o ServerAliveInterval=15 -o ServerAliveCountMax=3)

die() { echo "kuggis: $*" >&2; exit 1; }
row() { [ -f "$MAP" ] && awk -v p="$1" '$1 == p' "$MAP" || true; }
projects() { [ -f "$MAP" ] && awk 'NF && $1 !~ /^#/ { print $1 }' "$MAP" || true; }
host_of() {
  local r; r=$(row "$1")
  [ -n "$r" ] || die "unknown project '$1' (projects live in $MAP)"
  echo "$(awk '{ print $2 }' <<<"$r").exe.xyz"
}
check_name() {
  [[ $1 =~ ^[A-Za-z0-9][A-Za-z0-9_-]*$ ]] || die "bad session name '$1' (letters, digits, - and _)"
}
# Tokens copied out of a terminal often pick up a space where the line wrapped.
token() {
  local t
  t=$(security find-generic-password -s "$KEYCHAIN_SERVICE" -w 2>/dev/null | tr -d '[:space:]')
  [ -n "$t" ] || die "no Claude token in the keychain: run kuggis token"
  printf '%s\n' "$t"
}
remote() { local host=$1; shift; ssh "${SSH_OPTS[@]}" "$host" "$@"; }

# Every session on every VM: project, session, state, age (tab-separated).
sessions_tsv() {
  local ps p tmp
  ps=$(projects)
  [ -n "$ps" ] || return 0
  tmp=$(mktemp -d)
  for p in $ps; do
    (remote "$(host_of "$p")" '~/.box/session.sh status' >"$tmp/$p" 2>/dev/null ||
      printf -- '-\tunreachable\t-\n' >"$tmp/$p") &
  done
  wait
  for p in $ps; do
    if [ -s "$tmp/$p" ]; then sed "s/^/$p	/" "$tmp/$p"; else printf '%s\t-\tno sessions\t-\n' "$p"; fi
  done
  rm -rf "$tmp"
}

cmd_ls() {
  [ -n "$(projects)" ] || die "no VMs yet: kuggis new <project> <owner/repo>"
  { printf 'PROJECT\tSESSION\tSTATE\tAGE\n'; sessions_tsv; } | column -t -s "$(printf '\t')"
  local n; n=$(pending_briefs | wc -l | tr -d ' ')
  [ "$n" = 0 ] || echo "$n brief(s) from the Thinker waiting: kuggis dispatch"
}

cmd_attach() {
  local p='' name='' agent='' a host
  for a in "$@"; do
    case $a in
      --codex) agent=codex ;;
      --claude) agent=claude ;;
      -*) die "unknown flag $a" ;;
      *)
        if [ -z "$p" ]; then p=$a
        elif [ -z "$name" ]; then name=$a
        else die "usage: kuggis <project> [name] [--codex]"
        fi ;;
    esac
  done
  [ -n "$p" ] || die "usage: kuggis <project> [name] [--codex]"
  host=$(host_of "$p")
  if [ -z "$name" ]; then
    # shellcheck disable=SC2046
    set -- $(remote "$host" '~/.box/session.sh status' | cut -f1)
    case $# in
      0) die "no sessions on $p yet: kuggis $p <name>" ;;
      1) name=$1 ;;
      *) PS3="session: "; select name in "$@"; do [ -n "$name" ] && break; done ;;
    esac
  fi
  check_name "$name"
  # ssh exits 255 when the connection drops (sleep, network change, `~.`).
  # Once a session has been up a while, keep reattaching until it comes back;
  # a first attempt that fails fast is a real error and ends here.
  local rc t0 live=0
  while :; do
    t0=$(date +%s) rc=0
    ssh -t "${SSH_OPTS[@]}" "$host" "~/.box/session.sh attach $name $agent" || rc=$?
    [ "$rc" -eq 255 ] || return "$rc"
    [ $(($(date +%s) - t0)) -lt 30 ] || live=1
    [ "$live" = 1 ] || exit 255
    echo "kuggis: lost $host, reconnecting to $name (ctrl-c to stop)" >&2
    sleep 3
  done
}

cmd_done() {
  [ $# -ge 2 ] || die "usage: kuggis done <project> <name> [--force]"
  check_name "$2"
  case ${3:-} in '' | --force) ;; *) die "unknown flag $3" ;; esac
  remote "$(host_of "$1")" "~/.box/session.sh done $2 ${3:-}"
}

# Copy a file to ~/inbox on a VM; print its path there.
upload() {
  local host=$1 file=$2 base dest home
  base=$(basename "$file" | LC_ALL=C tr -c 'A-Za-z0-9._\n-' '_')
  dest=inbox/$(date +%Y%m%d-%H%M%S)-$base
  home=$(remote "$host" 'mkdir -p ~/inbox && echo $HOME' </dev/null)
  scp -q "${SSH_OPTS[@]}" "$file" "$host:$dest" </dev/null
  echo "$home/$dest"
}

cmd_put() {
  local file='' p='' s='' a tmp='' dir path
  for a in "$@"; do
    if [ -f "$a" ]; then file=$a
    elif [ -z "$p" ]; then p=$a
    elif [ -z "$s" ]; then s=$a
    else die "usage: kuggis put [project] [session] [file]"
    fi
  done
  if [ -z "$p" ]; then
    # shellcheck disable=SC2046
    set -- $(projects)
    [ $# -eq 1 ] || die "which project? kuggis put <project> [session] [file]"
    p=$1
  fi
  [ -z "$s" ] || check_name "$s"
  host=$(host_of "$p")
  if [ -z "$file" ]; then
    tmp=$(mktemp -d)
    trap "rm -rf '$tmp'" EXIT
    if osascript -e "set f to open for access POSIX file \"$tmp/clipboard.png\" with write permission" \
      -e 'write (the clipboard as «class PNGf») to f' -e 'close access f' >/dev/null 2>&1; then
      file=$tmp/clipboard.png
    else
      dir=$(defaults read com.apple.screencapture location 2>/dev/null || echo "$HOME/Desktop")
      dir=${dir/#\~/$HOME}
      file=$(ls -t "$dir"/Screen* 2>/dev/null | head -1 || true)
      [ -n "$file" ] || die "no file given, no image on the clipboard, no screenshot in $dir"
    fi
  fi
  path=$(upload "$host" "$file")
  if [ -n "$s" ]; then
    remote "$host" "tmux send-keys -t '=$s:' -l -- '$path '" ||
      die "uploaded $path, but could not type it into session $s"
    echo "typed into $p/$s: $path"
  else
    printf %s "$path" | pbcopy
    echo "copied: $path"
  fi
}

wait_ssh() {
  local i
  for i in $(seq 1 45); do
    ssh -o BatchMode=yes -o ConnectTimeout=5 -o StrictHostKeyChecking=accept-new "$1" true 2>/dev/null && return 0
    sleep 2
  done
  die "$1 never answered ssh"
}

cmd_new() {
  local p='' repo='' vm='' profile='' extra=()
  while [ $# -gt 0 ]; do
    case $1 in
      --vm) vm=$2; shift 2 ;;
      --profile) profile=$2; shift 2 ;;
      --cpu | --memory | --disk) extra+=("$1=$2"); shift 2 ;;
      -*) die "unknown flag $1" ;;
      *)
        if [ -z "$p" ]; then p=$1
        elif [ -z "$repo" ]; then repo=$1
        else die "usage: kuggis new <project> <owner/repo> [--vm NAME] [--profile NAME]"
        fi
        shift ;;
    esac
  done
  [ -n "$p" ] && [ -n "$repo" ] || die "usage: kuggis new <project> <owner/repo> [--vm NAME] [--profile NAME]"
  [[ $p =~ ^[a-z0-9][a-z0-9-]*$ ]] || die "project names are lowercase letters, digits and -"
  case $p in ls | new | sync | sh | put | done | token | help) die "'$p' is a kuggis command" ;; esac
  [[ $repo =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]] || die "repo must be owner/name"
  [ -z "$(row "$p")" ] || die "$p already exists in $MAP"
  vm=${vm:-$p}
  [[ $vm =~ ^[a-z0-9][a-z0-9-]*$ ]] || die "VM names are lowercase letters, digits and -"
  profile=${profile:-$p}
  [ -f "$HERE/profiles/$profile.sh" ] || profile=-
  token >/dev/null
  remote exe.dev integrations setup github --list | grep -q 'No GitHub accounts' &&
    die "link GitHub to exe.dev first: ssh exe.dev integrations setup github"

  echo "creating VM ${vm}…"
  remote exe.dev "new --name=$vm --tag=box --no-email --comment=box:$repo ${extra[*]+${extra[*]}}"
  echo "granting $vm access to ${repo}…"
  # As exe.dev's bot, not as you: with main protected, the VM can push branches
  # and open PRs but can't approve or merge its own.
  remote exe.dev "integrations add github --name=gh-$vm --repository=$repo --attach=vm:$vm"
  # Shut the VM's outbound email gateway: a box must not be able to mail anyone,
  # owner included (no phishing channel). Inbound was already off (--no-email).
  echo "shutting outbound email on ${vm}…"
  remote exe.dev "share receive-email $vm --reply-policy=none" >/dev/null
  mkdir -p "$CONF"
  echo "$p $vm $repo $profile" >>"$MAP"
  wait_ssh "$vm.exe.xyz"
  sync_one "$p"
  echo "ready: kuggis $p <session-name>"
}

sync_one() {
  local p=$1 r vm repo profile host
  r=$(row "$p")
  [ -n "$r" ] || die "unknown project '$p'"
  read -r _ vm repo profile <<<"$r"
  host=$vm.exe.xyz
  echo "syncing $p ($host)…"
  COPYFILE_DISABLE=1 tar --no-xattrs -C "$HERE/vm" -cf - . |
    remote "$host" 'mkdir -p ~/.box && tar -C ~/.box -xf - 2>/dev/null'
  if [ "$profile" != - ]; then
    remote "$host" 'cat >~/.box/profile.sh' <"$HERE/profiles/$profile.sh"
  else
    remote "$host" 'rm -f ~/.box/profile.sh'
  fi
  # Agent notes for this project, appended to kuggis's CLAUDE.md block.
  if [ "$profile" != - ] && [ -f "$HERE/profiles/$profile.md" ]; then
    remote "$host" 'cat >~/.box/profile.md' <"$HERE/profiles/$profile.md"
  else
    remote "$host" 'rm -f ~/.box/profile.md'
  fi
  # Per-project secrets (KEY=value lines), exported into every session.
  local secrets=$CONF/secrets/$p.env
  if [ -f "$secrets" ]; then
    [ "$(stat -f %Lp "$secrets")" = 600 ] || echo "kuggis: warning: $secrets is readable by others (chmod 600 it)" >&2
    remote "$host" 'umask 077 && cat >~/.box/secrets.env' <"$secrets"
  else
    remote "$host" 'rm -f ~/.box/secrets.env'
  fi
  token | remote "$host" 'umask 077 && cat >~/.box/token'
  {
    printf 'BOX_PROJECT=%q\n' "$p"
    printf 'BOX_REPO=%q\n' "$repo"
    printf 'BOX_MODE=%q\n' "${BOX_MODE:-auto}"
    printf 'BOX_NTFY=%q\n' "$(cat "$CONF/ntfy" 2>/dev/null || true)"
    printf 'BOX_GIT_NAME=%q\n' "$(git config --global user.name)"
    printf 'BOX_GIT_EMAIL=%q\n' "$(git config --global user.email)"
    # Sessions use the same model and effort as Claude on this laptop.
    printf 'BOX_CLAUDE_PREFS=%q\n' "$(jq -c '{model, effortLevel, alwaysThinkingEnabled}
      | with_entries(select(.value != null))' ~/.claude/settings.json 2>/dev/null || echo '{}')"
  } | remote "$host" 'cat >~/.box/config'
  remote "$host" 'bash ~/.box/bootstrap.sh'
}

cmd_sync() {
  local p
  if [ $# -gt 0 ]; then sync_one "$1"; else for p in $(projects); do sync_one "$p"; done; fi
}

cmd_sh() {
  local host; host=$(host_of "$1"); shift
  exec ssh -t "${SSH_OPTS[@]}" "$host" "$@"
}

cmd_token() {
  echo "kuggis: a browser opens for the Claude sign-in; copy the token it prints."
  claude setup-token
  local t
  printf 'kuggis: paste the token (hidden): '
  read -rs t
  echo
  t=$(printf %s "$t" | tr -d '[:space:]')
  [[ $t == sk-ant-* ]] || die "that doesn't look like a Claude token"
  security add-generic-password -U -a "$USER" -s "$KEYCHAIN_SERVICE" -w "$t"
  echo "kuggis: stored. Push it to your VMs with: kuggis sync"
}

# ── Briefs from the Thinker ──────────────────────────────────────────────────
# The Thinker (kuggis think) can't reach a VM: it writes briefs to its outbox,
# and you dispatch them. A brief is the one way anything leaves its room, so
# each is shown in full before it goes. Every decision is logged with the
# brief's hash; a brief that changes after you saw it shows up again.
OUTBOX=${KUGGIS_OUTBOX:-/Users/thinker/workspace/outbox}
ROOM_INBOX=${KUGGIS_ROOM_INBOX:-/Users/thinker/workspace/inbox}
DLOG=$CONF/dispatch.log # time, decision, sha256, brief, project/session/agent

sha() { shasum -a 256 "$1" | cut -d' ' -f1; }

# One key from the person (a line when stdin isn't a terminal, as in tests).
ask() {
  local k=''
  if [ -t 0 ]; then read -rsn1 k; else read -r k || k=q; fi
  printf '%s' "$k"
}

# A key from the brief's front matter (between --- lines at the top).
brief_field() {
  awk -v k="$2" 'NR == 1 { if ($0 != "---") exit; next } $0 == "---" { exit }
    { i = index($0, ":"); if (i && substr($0, 1, i - 1) == k) {
      v = substr($0, i + 1); gsub(/^[ \t]+|[ \t\r]+$/, "", v); print v; exit } }' "$1"
}

# What in a brief could be data on its way out: URLs, long opaque strings,
# invisible characters, an odd size. A guide for your read, not a verdict.
brief_flags() {
  perl -CSD -ne '
    while (m{(https?://[^\s<>")\]]+)}g) { print "url     line $.: $1\n" }
    (my $l = $_) =~ s{https?://\S+}{}g;
    while ($l =~ m{([A-Za-z0-9+/=_-]{40,})}g) { print "opaque  line $.: " . substr($1, 0, 48) . "...\n" }
    print "hidden  line $.: invisible or direction-changing characters\n"
      if /[\x{200B}-\x{200F}\x{202A}-\x{202E}\x{2060}-\x{2064}\x{FEFF}]/;
  ' "$1" 2>/dev/null || echo "unreadable as UTF-8"
  local n; n=$(wc -c <"$1" | tr -d ' ')
  [ "$n" -le 20000 ] || echo "size    $n bytes: long for a brief"
}

# Briefs not yet dispatched or rejected, oldest first. A name that isn't plain
# is skipped: it came from the Thinker, so it's data, not a path to trust.
pending_briefs() {
  [ -d "$OUTBOX" ] || return 0
  local f
  ls -tr "$OUTBOX" 2>/dev/null | while IFS= read -r f; do
    [[ $f =~ ^[A-Za-z0-9._-]+\.md$ ]] && [ -f "$OUTBOX/$f" ] || continue
    [ -z "$(brief_field "$OUTBOX/$f" review)" ] || continue # a PR review, not a brief
    grep -q "$(sha "$OUTBOX/$f")" "$DLOG" 2>/dev/null || echo "$OUTBOX/$f"
  done
}

log_brief() { # log_brief <decision> <brief> <target>
  mkdir -p "$CONF"
  printf '%s\t%s\t%s\t%s\t%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$1" "$(sha "$2")" "$(basename "$2")" "$3" >>"$DLOG"
}

# Hand a brief to its session: upload it and have the VM start the session with
# it, or type it into the session if it's already running.
dispatch_brief() { # dispatch_brief <file> <project> <session> <agent>
  local host dest
  host=$(host_of "$2")
  # </dev/null throughout: ssh would otherwise read the keys meant for the next brief.
  remote "$host" 'grep -q "^  deliver)" ~/.box/session.sh' </dev/null ||
    die "$2's VM predates dispatch: kuggis sync $2"
  dest=$(upload "$host" "$1")
  remote "$host" "~/.box/session.sh deliver $3 $4 $dest" </dev/null
}

# Show a brief, then [d]ispatch, [e]dit, [s]kip or [r]eject it. Returns 1 to quit.
review_brief() {
  local orig=$1 f=$1 key p s a problem view
  while :; do
    p=$(brief_field "$f" project) s=$(brief_field "$f" session) a=$(brief_field "$f" agent)
    a=${a:-claude} problem=''
    [ -n "$p" ] && [ -n "$(row "$p")" ] || problem="project '$p' isn't one of yours: $(projects | tr '\n' ' ')"
    [[ $s =~ ^[A-Za-z0-9][A-Za-z0-9_-]*$ ]] || problem=${problem:-"session '$s' isn't a valid name"}
    case $a in claude | codex) ;; *) problem=${problem:-"agent '$a' isn't claude or codex"} ;; esac
    view=$(mktemp)
    {
      echo "brief    $(basename "$orig")$([ "$f" = "$orig" ] || echo '  (your edit)')"
      echo "goes to  $p / $s ($a)"
      [ -z "$problem" ] || echo "PROBLEM  $problem"
      echo "look at  (anything that could carry data out)"
      brief_flags "$f" | sed 's/^/  /' | grep . || echo "  nothing unusual"
      echo "────────────────────────────────────────────────────────────"
      cat "$f"
    } >"$view"
    if [ -t 1 ]; then ${KUGGIS_PAGER:-less -RFX} "$view"; else cat "$view"; fi
    rm -f "$view"
    printf '\n[d]ispatch  [e]dit  [s]kip  [r]eject  [q]uit: '
    key=$(ask)
    echo "$key"
    case $key in
      d)
        if [ -n "$problem" ]; then echo "can't dispatch: $problem. [e]dit it first."; continue; fi
        dispatch_brief "$f" "$p" "$s" "$a"
        log_brief "dispatched$([ "$f" = "$orig" ] || echo ' (edited)')" "$orig" "$p/$s/$a"
        echo "attach with: kuggis $p $s"
        return 0 ;;
      e)
        if [ "$f" = "$orig" ]; then
          mkdir -p "$CONF/dispatch"
          f=$CONF/dispatch/$(date +%Y%m%d-%H%M%S)-$(basename "$orig")
          cp "$orig" "$f"
        fi
        ${EDITOR:-vi} "$f" </dev/tty >/dev/tty ;;
      s) return 0 ;;
      r) log_brief rejected "$orig" "$p/$s/$a"; echo "rejected"; return 0 ;;
      *) return 1 ;;
    esac
  done
}

# What the Thinker can read about your sessions and PRs: its inbox gets
# status.md and each open PR's diff under prs/. Best effort.
room_status() {
  [ -d "$ROOM_INBOX" ] && [ -w "$ROOM_INBOX" ] || return 0
  local p repo n tmp
  tmp=$(mktemp -d)
  mkdir "$tmp/prs"
  {
    echo "# Sessions and PRs, $(date '+%Y-%m-%d %H:%M')"
    echo
    echo "Written by kuggis on the laptop. PR text and diffs are written by VM sessions."
    echo
    echo '```'
    { printf 'PROJECT\tSESSION\tSTATE\tAGE\n'; sessions_tsv; } | column -t -s "$(printf '\t')"
    echo '```'
    for p in $(projects); do
      repo=$(row "$p" | awk '{ print $3 }')
      echo
      echo "## $p ($repo): open PRs"
      echo
      gh pr list -R "$repo" --state open --limit 20 \
        --json number,title,headRefName,headRefOid,baseRefName,author,updatedAt,statusCheckRollup \
        --jq ".[] | \"- #\\(.number) \\(.title) (branch \\(.headRefName) into \\(.baseRefName), head \\(.headRefOid[:12]), checks \\($CHECKS_JQ), by \\(.author.login), updated \\(.updatedAt[:16]))\"" \
        2>/dev/null || echo "(couldn't list PRs)"
      for n in $(gh pr list -R "$repo" --state open --limit 20 --json number --jq '.[].number' 2>/dev/null); do
        gh pr diff "$n" -R "$repo" 2>/dev/null | head -c 300000 >"$tmp/prs/${repo//\//-}-$n.diff" || true
      done
    done
  } >"$tmp/status.md"
  chmod -R a+rX "$tmp"
  rm -rf "$ROOM_INBOX/prs"
  mv "$tmp/prs" "$ROOM_INBOX/prs"
  mv "$tmp/status.md" "$ROOM_INBOX/status.md"
  rm -rf "$tmp"
}

# ── Pull requests ────────────────────────────────────────────────────────────
# Open PRs on each project's repo, with the Thinker's review when it wrote one
# (outbox/review-*.md, front matter: review: owner/repo#N, head, verdict).
# Merging is yours: it decides what code runs later, often as you.
CHECKS_JQ='([.statusCheckRollup[]? | (.conclusion // .state // "") as $r
  | if ((.status? // "COMPLETED") != "COMPLETED") or $r == "PENDING" or $r == "" then "pending"
    elif ($r | test("SUCCESS|NEUTRAL|SKIPPED")) then "ok" else "failing" end]
  | if length == 0 then "none" elif index("failing") then "failing"
    elif index("pending") then "pending" else "ok" end)'

# project, repo, number, head branch, head commit, base, author, checks, title (tab-separated)
prs_tsv() {
  local p repo tmp
  tmp=$(mktemp -d)
  for p in $(projects); do
    repo=$(row "$p" | awk '{ print $3 }')
    (gh pr list -R "$repo" --state open --limit 30 \
      --json number,title,headRefName,headRefOid,baseRefName,author,statusCheckRollup \
      --jq ".[] | [\"$p\", \"$repo\", .number, .headRefName, .headRefOid, .baseRefName, .author.login,
        $CHECKS_JQ, (.title | gsub(\"\\t\"; \" \"))] | @tsv" >"$tmp/$p" 2>/dev/null || true) &
  done
  wait
  for p in $(projects); do cat "$tmp/$p" 2>/dev/null || true; done
  rm -rf "$tmp"
}

# The Thinker's newest review of owner/repo#N, if any.
review_for() {
  [ -d "$OUTBOX" ] || return 0
  local f want
  want=$(tr '[:upper:]' '[:lower:]' <<<"$1#$2")
  ls -t "$OUTBOX" 2>/dev/null | while IFS= read -r f; do
    [[ $f =~ ^[A-Za-z0-9._-]+\.md$ ]] && [ -f "$OUTBOX/$f" ] || continue
    if [ "$(brief_field "$OUTBOX/$f" review | tr '[:upper:]' '[:lower:]')" = "$want" ]; then
      echo "$OUTBOX/$f"
      break
    fi
  done
}

# Run, or with KUGGIS_DRY_RUN=1 only say what would run.
act() { if [ -n "${KUGGIS_DRY_RUN:-}" ]; then echo "would run: $*"; else "$@"; fi; }

# Merge a PR: approve it if someone else wrote it (a VM session), or use your
# admin bypass if you did. Only the commit you saw merges (--match-head-commit).
# A PR others are stacked on merges as a merge commit, and they move to its
# base before its branch is deleted: deleting a base branch closes its PRs.
merge_pr() { # merge_pr <repo> <n> <head-branch> <head-commit> <base> <author>
  local repo=$1 n=$2 head=$3 sha=$4 base=$5 author=$6 me how=--squash admin='' kids c
  me=$(gh api user -q .login)
  kids=$(gh pr list -R "$repo" --state open --base "$head" --json number -q '.[].number')
  [ -z "$kids" ] || how=--merge
  if [ "$author" = "$me" ]; then admin=--admin
  else act gh pr review "$n" -R "$repo" --approve -b "Reviewed with the Thinker; merged from kuggis."
  fi
  act gh pr merge "$n" -R "$repo" "$how" ${admin:+"$admin"} --match-head-commit "$sha"
  for c in $kids; do act gh api -X PATCH "repos/$repo/pulls/$c" -f base="$base" --silent; done
  act gh api -X DELETE "repos/$repo/git/refs/heads/$head" --silent || true
}

# Send a review to the session that wrote the PR (its branch is its name).
send_review() { # send_review <project> <repo> <n> <head-branch> <review-file>
  local f
  check_name "$4"
  f=$(mktemp -d)/review-${2//\//-}-$3.md
  {
    printf -- '---\nproject: %s\nsession: %s\n---\n' "$1" "$4"
    echo "The owner sends you this review of your PR $2#$3. Address it on this branch, push, and reply with what you changed."
    echo
    awk 'NR == 1 && $0 == "---" { fm = 1; next } fm && $0 == "---" { fm = 0; next } !fm' "$5"
  } >"$f"
  if [ -n "${KUGGIS_DRY_RUN:-}" ]; then echo "would send to $1/$4:"; cat "$f"; return 0; fi
  dispatch_brief "$f" "$1" "$4" "$(remote "$(host_of "$1")" "cat ~/.box/agent/$4 2>/dev/null || echo claude" </dev/null)"
  log_brief "review sent" "$5" "$1/$4 for $2#$3"
}

# One PR: its summary, the Thinker's review, then [m]erge, [c]hanges (send the
# review to its session), [v]iew the diff, [o]pen it on GitHub, [s]kip.
pr_screen() { # pr_screen <tsv row>
  local p repo n head sha base author checks title rev view key verdict rhead stale='' def
  IFS=$'\t' read -r p repo n head sha base author checks title <<<"$1"
  rev=$(review_for "$repo" "$n")
  def=$(gh repo view "$repo" --json defaultBranchRef -q .defaultBranchRef.name 2>/dev/null || echo main)
  while :; do
    view=$(mktemp)
    {
      echo "$repo#$n  $title"
      echo "by $author   $head → $base   head ${sha:0:12}   checks: $checks"
      gh pr view "$n" -R "$repo" --json additions,deletions,files \
        --jq '"\(.files | length) files, +\(.additions) −\(.deletions)", (.files[:25][] | "  +\(.additions) −\(.deletions)  \(.path)")' 2>/dev/null
      echo "────────────────────────────────────────────────────────────"
      if [ -n "$rev" ]; then
        verdict=$(brief_field "$rev" verdict) rhead=$(brief_field "$rev" head)
        [ -n "$rhead" ] && [[ $sha == "$rhead"* ]] || stale="  STALE: reviewed ${rhead:-an unknown commit}; the PR has moved on"
        echo "The Thinker: ${verdict:-no verdict}$stale"
        echo "look at  (anything that could carry data out, if you send it on)"
        brief_flags "$rev" | sed 's/^/  /' | grep . || echo "  nothing unusual"
        echo
        awk 'NR == 1 && $0 == "---" { fm = 1; next } fm && $0 == "---" { fm = 0; next } !fm' "$rev"
      else
        echo "No review from the Thinker yet. It sees this PR's diff in its inbox."
      fi
    } >"$view"
    if [ -t 1 ]; then ${KUGGIS_PAGER:-less -RFX} "$view"; else cat "$view"; fi
    rm -f "$view"
    printf '\n[m]erge  [c]hanges to its session  [v]iew diff  [o]pen  [s]kip: '
    key=$(ask)
    echo "$key"
    case $key in
      m)
        [ "$base" = "$def" ] || { echo "this PR is stacked on $base: merge that one first"; continue; }
        [ "$checks" != failing ] || echo "checks are failing."
        [ -z "$stale" ] || echo "the Thinker's review is of an older commit."
        printf 'merge %s#%s at %s into %s? [y/N] ' "$repo" "$n" "${sha:0:12}" "$base"
        [ "$(ask)" = y ] || { echo; continue; }
        echo
        merge_pr "$repo" "$n" "$head" "$sha" "$base" "$author"
        log_brief merged "${rev:-/dev/null}" "$repo#$n at ${sha:0:12}"
        return 0 ;;
      c)
        [ -n "$rev" ] || { echo "no review to send yet"; continue; }
        [ -n "$(row "$p")" ] || { echo "no kuggis project for $repo"; continue; }
        printf 'send the review to %s / %s? [y/N] ' "$p" "$head"
        [ "$(ask)" = y ] || { echo; continue; }
        echo
        send_review "$p" "$repo" "$n" "$head" "$rev"
        return 0 ;;
      v) gh pr diff "$n" -R "$repo" --color always | less -R ;;
      o) gh pr view "$n" -R "$repo" --web >/dev/null 2>&1 ;;
      *) return 0 ;;
    esac
  done
}

cmd_dispatch() {
  case ${1:-} in
    --status) room_status; echo "kuggis: wrote $ROOM_INBOX/status.md"; return ;;
    '') ;;
    *) die "usage: kuggis dispatch [--status]" ;;
  esac
  local f n=0
  for f in $(pending_briefs); do
    n=$((n + 1))
    review_brief "$f" || break
  done
  [ "$n" -gt 0 ] || echo "kuggis: no briefs waiting in $OUTBOX"
  room_status
}

# `kuggis` at a terminal: what's waiting on you in one place. Briefs to review,
# open PRs (with the Thinker's review), every session; pick one to act on it.
cmd_home() {
  local i choice line p s st age repo n head sha base author checks title rev verdict
  local briefs=() prs=() rows=() C='' Y='' D='' N='' R=''
  [ -t 1 ] && C=$'\e[1m' Y=$'\e[33m' D=$'\e[2m' N=$'\e[0m' R=$'\e[31m'
  (room_status >/dev/null 2>&1 &)
  while :; do
    briefs=() prs=() rows=()
    while IFS= read -r line; do [ -n "$line" ] && briefs+=("$line"); done < <(pending_briefs)
    while IFS= read -r line; do [ -n "$line" ] && prs+=("$line"); done < <(prs_tsv)
    while IFS= read -r line; do
      [ "$(cut -f2 <<<"$line")" != - ] && rows+=("$line")
    done < <(sessions_tsv)
    i=0
    echo
    if [ ${#briefs[@]} -gt 0 ]; then
      echo "${C}Briefs from the Thinker${N}"
      for line in "${briefs[@]}"; do
        i=$((i + 1))
        printf '  %2d  %-28s %-7s %s\n' "$i" "$(brief_field "$line" project) / $(brief_field "$line" session)" \
          "$(brief_field "$line" agent)" "$D$(basename "$line")$N"
      done
    fi
    if [ ${#prs[@]} -gt 0 ]; then
      echo "${C}Pull requests${N}"
      for line in "${prs[@]}"; do
        i=$((i + 1))
        IFS=$'\t' read -r p repo n head sha base author checks title <<<"$line"
        rev=$(review_for "$repo" "$n") verdict='no review'
        if [ -n "$rev" ]; then
          verdict="Thinker: $(brief_field "$rev" verdict)"
          [[ $sha == "$(brief_field "$rev" head)"* ]] && [ -n "$(brief_field "$rev" head)" ] || verdict="$verdict (stale)"
        fi
        case $checks in failing) checks="$R$(printf '%-8s' "$checks")$N" ;; *) checks=$(printf '%-8s' "$checks") ;; esac
        printf '  %2d  %-20s %-40.40s %s %s\n' "$i" "${repo#*/} #$n" "$title" "$checks" "$D$verdict$N"
      done
    fi
    echo "${C}Sessions${N}"
    if [ ${#rows[@]} -eq 0 ]; then echo "  (none)"; else
      for line in "${rows[@]}"; do
        i=$((i + 1))
        IFS=$'\t' read -r p s st age <<<"$line"
        st=$(printf '%-16s' "$st")
        case $st in "waiting on you"*) st="$Y$st$N" ;; esac
        printf '  %2d  %-28s %s %s\n' "$i" "$p / $s" "$st" "$D$age$N"
      done
    fi
    printf '\npick a number, [r]efresh, [q]uit: '
    read -r choice || return 0
    case $choice in
      q | '') return 0 ;;
      r) continue ;;
      *[!0-9]*) continue ;;
    esac
    local nb=${#briefs[@]} np=${#prs[@]} ns=${#rows[@]}
    if [ "$choice" -ge 1 ] && [ "$choice" -le "$nb" ]; then
      review_brief "${briefs[$((choice - 1))]}" || true
      (room_status >/dev/null 2>&1 &)
    elif [ "$choice" -gt "$nb" ] && [ "$choice" -le $((nb + np)) ]; then
      pr_screen "${prs[$((choice - nb - 1))]}" || true
      (room_status >/dev/null 2>&1 &)
    elif [ "$choice" -gt $((nb + np)) ] && [ "$choice" -le $((nb + np + ns)) ]; then
      IFS=$'\t' read -r p s _ <<<"${rows[$((choice - nb - np - 1))]}"
      cmd_attach "$p" "$s" || true
    fi
  done
}

# The Thinker's room (think/README.md): a separate macOS user running Claude
# Code restricted, entered through a root-owned launcher.
cmd_think() {
  local room=/opt/kuggis-thinker
  cd / # the thinker user can't enter your folders; don't start it in one
  case ${1:-} in
    --setup)
      local bin token
      bin=$(readlink -f "$(command -v claude)") || die "no claude on PATH"
      token=$(security find-generic-password -s "$KEYCHAIN_SERVICE" -w 2>/dev/null) || die "no Claude token yet: kuggis token"
      echo "kuggis: building the Thinker's room (sudo asks for your password)"
      printf '%s' "$token" | sudo "$HERE/think/setup.sh" "$USER" "$bin"
      ;;
    --check)
      sudo -u thinker "$room/check" "$USER" || true
      echo
      echo "kuggis: now the tool-level half. Paste this into a Thinker session (kuggis think);"
      echo "        it should report each step as expected, refusals included:"
      echo
      sed "s|/Users/OWNER|/Users/$USER|" "$room/check-prompt.md"
      ;;
    "" | -*)
      [ -x "$room/launch" ] || die "no Thinker room yet: kuggis think --setup"
      exec sudo -u thinker "$room/launch" "$@" ;;
    *) die "usage: kuggis think [--setup|--check|<claude flags>]" ;;
  esac
}

case ${1:-home} in
  home) if [ -t 0 ] && [ -t 1 ]; then cmd_home; else cmd_ls; fi ;;
  ls) cmd_ls ;;
  dispatch) shift; cmd_dispatch "$@" ;;
  new) shift; cmd_new "$@" ;;
  sync) shift; cmd_sync "$@" ;;
  done) shift; cmd_done "$@" ;;
  put) shift; cmd_put "$@" ;;
  sh) shift; [ $# -ge 1 ] || die "usage: kuggis sh <project> [cmd...]"; cmd_sh "$@" ;;
  token) cmd_token ;;
  think) shift; cmd_think "$@" ;;
  help | -h | --help) sed -n '2,/^set -e/p' "$SELF" | sed '$d; s/^# \{0,1\}//' ;;
  --codex | --claude) cmd_attach "$@" ;;
  -*) die "unknown flag $1 (kuggis help)" ;;
  *) cmd_attach "$@" ;;
esac
