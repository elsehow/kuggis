#!/usr/bin/env python3
"""Check each outgoing commit's history before Git publishes it."""

from pathlib import Path
import subprocess
import sys

checker = Path(__file__).resolve().with_name("check-private-state.py")
for line in sys.stdin:
    _, revision, _, _ = line.split()
    if set(revision) == {"0"}:  # Deleting a remote ref publishes no commits.
        continue
    result = subprocess.run(
        [sys.executable, str(checker), "--history", "--revision", revision]
    )
    if result.returncode:
        sys.exit(result.returncode)
