[Unit]
Description=Kuggis restricted publishing signer (cell VM)
After=local-fs.target
ConditionPathExists=/etc/cell/publisher.json

[Service]
User=cell-say
Group=cell-say
EnvironmentFile=/etc/cell/publisher.env
ExecStart=/usr/local/bin/cell publisher bridge --config /etc/cell/publisher.json --cell /etc/cell/cell.json --secret /etc/cell/secret --agent-uid ${AGENT_UID}
Restart=on-failure
RuntimeDirectory=cell-publish
RuntimeDirectoryMode=0711
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX
MemoryMax=128M

[Install]
WantedBy=multi-user.target
