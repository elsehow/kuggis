#!/usr/bin/python3
"""The Thinker's WebFetch guard (a PreToolUse hook).

A fetch goes through only if its URL came from outside the model, exactly as
given, and points at the public internet. The URL must appear in one of:

  - a message the person typed;
  - a WebSearch result's structured links (never the result's text, which
    echoes the model's own query);
  - a BigBrain read (mcp__bigbrain__*), unless the model itself sent that URL
    to a BigBrain tool first (a drop it reads back).

Links inside fetched pages don't count: WebFetch's result is a model's summary
written to the model's own prompt, so it can echo whatever the model asks.
Anything unexpected refuses: the guard fails closed.
"""
import json
import os
import re
import sys
from urllib.parse import urlsplit

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
from door import public_host, system_resolve  # noqa: E402  the one URL rule, shared with the door

URL_RE = re.compile(r"https?://[^\s<>\"'`\])}]+")
TRAILING = ".,;:!?*_~"
BIGBRAIN = "mcp__bigbrain__"


def urls_in(text):
    return {u.rstrip(TRAILING) for u in URL_RE.findall(text or "")}


def texts(content):
    """The text of a message or tool result, whatever its shape."""
    if isinstance(content, str):
        return [content]
    out = []
    for block in content or []:
        if isinstance(block, str):
            out.append(block)
        elif isinstance(block, dict):
            if block.get("type") == "text":
                out.append(block.get("text", ""))
            elif "content" in block:
                out.extend(texts(block["content"]))
    return out


def search_links(results):
    """URLs from WebSearch's structured results: [{content: [{title, url}]}]."""
    out = set()
    for r in results or []:
        if isinstance(r, dict):
            for item in r.get("content") or []:
                if isinstance(item, dict) and isinstance(item.get("url"), str):
                    out.add(item["url"])
    return out


def allowed_urls(lines):
    """URLs that came from outside, from the transcript's JSON lines."""
    names, outside, sent_to_bigbrain = {}, set(), set()
    entries = [json.loads(line) for line in lines if line.strip()]
    for e in entries:
        content = (e.get("message") or {}).get("content")
        if e.get("type") == "assistant" and isinstance(content, list):
            for b in content:
                if isinstance(b, dict) and b.get("type") == "tool_use":
                    names[b.get("id")] = b.get("name", "")
                    if b.get("name", "").startswith(BIGBRAIN):
                        sent_to_bigbrain |= urls_in(json.dumps(b.get("input")))
    for e in entries:
        if e.get("type") != "user" or e.get("isMeta") or e.get("isSidechain"):
            continue
        content = (e.get("message") or {}).get("content")
        if isinstance(content, str):
            outside |= urls_in(content)
            continue
        for b in content or []:
            if not isinstance(b, dict):
                continue
            if b.get("type") == "text" and not b.get("text", "").lstrip().startswith("<system-reminder>"):
                outside |= urls_in(b.get("text"))
            elif b.get("type") == "tool_result":
                name = names.get(b.get("tool_use_id"), "")
                if name == "WebSearch":
                    result = e.get("toolUseResult")
                    if isinstance(result, dict):
                        outside |= search_links(result.get("results"))
                elif name.startswith(BIGBRAIN):
                    outside |= {u for t in texts(b.get("content")) for u in urls_in(t)} - sent_to_bigbrain
    return outside


def verdict(event, resolve=system_resolve):
    """None to allow, else the reason to refuse."""
    url = (event.get("tool_input") or {}).get("url")
    if not isinstance(url, str) or not url:
        return "no URL"
    parts = urlsplit(url)
    if parts.scheme not in ("http", "https") or parts.username or parts.password:
        return "only plain http(s) URLs"
    if not public_host(parts.hostname or "", resolve):
        return "only public hosts (no localhost, private or unresolvable addresses)"
    try:
        with open(event["transcript_path"], encoding="utf-8") as f:
            outside = allowed_urls(f)
    except (KeyError, OSError, ValueError):
        return "can't read the transcript to check where this URL came from"
    if url not in outside:
        return ("this URL didn't come from outside, exactly as given: fetch only links from "
                "WebSearch results, BigBrain notes, or the person's messages. If it just "
                "arrived, try once more; to follow a link inside a page, ask the person.")
    return None


def main():
    try:
        reason = verdict(json.load(sys.stdin))
    except Exception as e:  # fail closed
        reason = f"guard error: {type(e).__name__}"
    if reason:
        json.dump({"hookSpecificOutput": {"hookEventName": "PreToolUse", "permissionDecision": "deny",
                                          "permissionDecisionReason": f"Thinker fetch guard: {reason}"}}, sys.stdout)
    sys.exit(0)


if __name__ == "__main__":
    main()
